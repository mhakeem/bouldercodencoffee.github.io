<header class="bg-white dark:bg-gray-900 shadow-md relative transition duration-300">
  <div class="container mx-auto px-4 py-4">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl md:text-3xl font-display font-bold flex items-center">
        <a href="<%= relative_url "/" %>">
          <i class="fas fa-coffee mr-2 text-coffee"></i>
          <i class="fas fa-code mr-2 text-code"></i>
          <span class="bg-clip-text text-transparent bg-gradient-to-r from-coffee to-code">
            Boulder Code &amp;&amp; Coffee
          </span>
        </a>
      </h1>
      <div class="flex items-center">
        <nav id="main-menu" class="hidden md:block absolute md:relative left-0 right-0 top-full md:top-auto bg-white dark:bg-gray-900 md:bg-transparent shadow-md md:shadow-none transition duration-300">
          <ul class="flex flex-col md:flex-row md:space-x-8 text-lg container mx-auto px-4 py-4 md:p-0">
            <li class="mb-2 md:mb-0"><a href="<%= relative_url "/" %>" class="block text-coffee dark:text-coffee-light hover:text-code transition duration-300">Home</a></li>
            <li class="mb-2 md:mb-0"><a href="<%= relative_url "/events" %>" class="block text-coffee dark:text-coffee-light hover:text-code transition duration-300">Events</a></li>
            <li class="mb-2 md:mb-0">
              <a href="<%= relative_url "/feed/events.xml" %>" class="block text-coffee dark:text-coffee-light hover:text-code transition duration-300">
                <i class="fa-solid fa-square-rss text-2xl"></i>
              </a>
            </li>
          </ul>
        </nav>
        <button id="dark-mode-toggle" aria-label="Toggle dark mode" class="relative inline-flex items-center h-6 w-11 rounded-full bg-gray-300 dark:bg-gray-600 transition-colors duration-300 focus:outline-none ml-4 flex-shrink-0">
          <span class="absolute left-1 h-4 w-4 rounded-full bg-white shadow-sm transform transition-transform duration-300 translate-x-0 dark:translate-x-5 flex items-center justify-center">
            <i class="fas fa-sun text-[10px] text-yellow-500 dark:!hidden"></i>
            <i class="fas fa-moon text-[10px] text-code !hidden dark:!inline"></i>
          </span>
        </button>
        <button id="menu-toggle" class="md:hidden text-coffee dark:text-coffee-light focus:outline-none ml-4 mr-4 relative w-6 h-6">
          <span class="hamburger-line absolute h-0.5 w-6 bg-coffee dark:bg-coffee-light transform transition-all duration-300 ease-in-out"></span>
          <span class="hamburger-line absolute h-0.5 w-6 bg-coffee dark:bg-coffee-light transform transition-all duration-300 ease-in-out"></span>
          <span class="hamburger-line absolute h-0.5 w-6 bg-coffee dark:bg-coffee-light transform transition-all duration-300 ease-in-out"></span>
        </button>
      </div>
    </div>
  </div>
</header>
