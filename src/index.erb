---
# Feel free to add content and custom Front Matter to this file.

layout: default
---

<div class="relative bg-cover bg-center py-16 md:py-28" style="background-image: url('<%= relative_url "/images/flatirons-medium.jpg" %>')" role="img" aria-label="The Flatirons mountains in Boulder, Colorado. Photo by Logan Gutierrez.">
  <div class="absolute inset-0 bg-gradient-to-br from-coffee to-code opacity-80"></div>
  <div class="container mx-auto text-center px-4 relative z-10 text-white">
    <h2 class="text-4xl md:text-5xl font-display font-bold mb-6 leading-tight">Where Code Meets Community<br>
      in Boulder, Colorado</h2>
    <p class="text-xl max-w-2xl mx-auto">Join fellow developers for inspiring coding sessions in Boulder's finest cafés and breweries. Collaborate, learn, and grow together!</p>
  </div>
</div>

<% if (upcoming_event = collections.events.resources.last) %>
  <%= render "event", event: upcoming_event %>
<% end %>

<div class="bg-gray-100 dark:bg-gray-800 py-16 transition duration-300">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-display font-bold mb-8 text-center text-coffee dark:text-coffee-light">Why Join Us?</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white dark:bg-gray-700 p-6 rounded-lg shadow-md transition duration-300">
        <i class="fas fa-laptop-code text-4xl mb-4 text-code"></i>
        <h3 class="text-xl font-bold mb-2 dark:text-white">Collaborative Coding</h3>
        <p class="text-gray-600 dark:text-gray-300">Work on projects together and learn from your peers in a supportive environment.</p>
      </div>
      <div class="bg-white dark:bg-gray-700 p-6 rounded-lg shadow-md transition duration-300">
        <i class="fas fa-mug-hot text-4xl mb-4 text-code"></i>
        <h3 class="text-xl font-bold mb-2 dark:text-white">Great Coffee & Brews</h3>
        <p class="text-gray-600 dark:text-gray-300">Enjoy some of Boulder's finest coffee and craft beers while you code and connect.</p>
      </div>
      <div class="bg-white dark:bg-gray-700 p-6 rounded-lg shadow-md transition duration-300">
        <i class="fas fa-users text-4xl mb-4 text-code"></i>
        <h3 class="text-xl font-bold mb-2 dark:text-white">Community Building</h3>
        <p class="text-gray-600 dark:text-gray-300">Network with local developers and build lasting professional relationships.</p>
      </div>
    </div>
  </div>
</div>
